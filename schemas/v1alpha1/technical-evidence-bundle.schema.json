{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.planeon.ai/conformance/v1alpha1/technical-evidence-bundle.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "campaignId", "environmentId", "issuedAt", "originatedAxes", "producer", "reportDigest", "resultStatus", "subjectDigests", "tenantId", "bundleDigest"],
  "properties": {
    "schemaVersion": {"const": "harness.planeon.ai/technical-evidence-bundle/v1alpha1"},
    "bundleId": {"type": "string"}, "campaignId": {"type": "string"}, "environmentId": {"type": "string"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "originatedAxes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["SOURCE", "UNIT", "CI", "MERGE", "ARTIFACT", "SIGNATURE", "DEPLOYMENT", "RUNTIME", "SECURITY", "ASSURANCE", "TENANT_ACCEPTANCE_CANDIDATE"]}},
    "producer": {"type": "string"}, "reportDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resultStatus": {"enum": ["PASS", "FAIL", "WARN", "NOT_APPLICABLE", "NOT_RUN_ENV_UNAVAILABLE"]},
    "subjectDigests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "tenantId": {"type": "string"}, "bundleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signerKeyId": {"type": "string"}, "signaturePurpose": {"const": "TECHNICAL_EVIDENCE"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
