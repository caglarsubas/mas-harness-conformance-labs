{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.planeon.ai/conformance/v1alpha1/conformance-campaign.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignId", "version", "description", "executionClass", "environmentFixture", "controls"],
  "properties": {
    "schemaVersion": {"const": "harness.planeon.ai/conformance-campaign/v1alpha1"},
    "campaignId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 128},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 512},
    "executionClass": {"enum": ["OFFLINE_TEST", "LIVE_CAMPAIGN"]},
    "environmentFixture": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.json$", "maxLength": 512},
    "controls": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["controlId", "handler", "required", "axis", "input"],
        "properties": {
          "controlId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 128},
          "handler": {"enum": ["STATIC_ASSERTION", "SCHEMA_ASSERTION", "LIFECYCLE_ASSERTION", "EVENT_ASSERTION", "ENVIRONMENT_CAPABILITY"]},
          "required": {"type": "boolean"},
          "axis": {"enum": ["SOURCE", "UNIT", "CI", "MERGE", "ARTIFACT", "SIGNATURE", "DEPLOYMENT", "RUNTIME", "SECURITY", "ASSURANCE", "TENANT_ACCEPTANCE_CANDIDATE", "TENANT_ACCEPTANCE"]},
          "input": {"type": "object", "maxProperties": 32}
        }
      }
    }
  }
}
