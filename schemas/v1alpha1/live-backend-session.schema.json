{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness.planeon.ai/live-backend-session/v1alpha1",
  "title": "Internal live-backend session data; never execution authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "nonce",
    "tenantId",
    "environmentId",
    "endpointId",
    "namespace",
    "packetDigest",
    "commandSetDigest",
    "releaseDigest",
    "capacityDigest",
    "issuedAt",
    "expiresAt",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "const": "harness.planeon.ai/live-backend-session/v1alpha1"
    },
    "nonce": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "tenantId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "environmentId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "endpointId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "namespace": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "packetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commandSetDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "releaseDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capacityDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "state": {
      "enum": [
        "UNAVAILABLE",
        "VALIDATED_DATA",
        "RESERVED",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "EXPIRED"
      ]
    }
  },
  "$comment": "Runtime data validator additionally enforces 16384 canonical UTF-8 bytes, depth <=8, no duplicates/nonfinite/object hooks, validity intersection and external expected binding. Data does not establish custody or nonce reservation."
}
